{
  // Interpréteur Python du projet : environnement virtuel local (.venv).
  // Nécessaire pour que Pylance résolve fastapi / uvicorn / httpx.
  // Recréer avec :
  //   python -m venv .venv
  //   .venv\Scripts\pip install -r requirements.txt
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": ["${workspaceFolder}/.venv/Lib/site-packages"],
  "python.analysis.typeCheckingMode": "basic",

  // Exclure les artefacts et caches de l'éditeur
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.venv": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.webview": true,
    "build": true,
    "dist": true
  },
  "CodeGPT.apiKey": "CodeGPT Plus Beta"
}